# 先複製成 .env 再填入金鑰，不要上傳到 GitHub。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 請至 @BotFather 建立 Telegram Bot；先對 Bot 發送 /start。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2026/11/22（日），到達新竹高鐵站的時間是 19:45。
TRAVEL_DATE=2026-11-22
ARRIVAL_AT_STATION=19:45
ORIGIN_STATION_ID=1030
DESTINATION_STATION_ID=1000

# 到站後至少預留 7 分鐘買票、驗票、上月台。
BOARDING_BUFFER_MINUTES=7
# 每 300 秒查一次；TDX 的資料本身通常每 10 分鐘更新一次。
POLL_SECONDS=300
